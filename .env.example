APP_NAME=Lux
DATABASE_URL=postgresql://postgres:phanuel@localhost:5432/lux
TEST_DATABASE_URL=sqlite:///:memory:

# Server
PORT=7783

JWT_SECRET_KEY=jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPER_ADMIN_NAME=super admin name
SUPER_ADMIN_EMAIL=super admin email
SUPER_ADMIN_PASSWORD=super admin pw

MAIL_USERNAME=mail username
MAIL_PASSWORD=mail pw
MAIL_FROM=mail from email
MAIL_FROM_NAME=Lux
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true

VERIFICATION_CODE_EXPIRES_IN_MINUTE=10
PASSWORD_RESET_CODE_EXPIRES_IN_MINUTE=10
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_LENGTH=6

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model format: "provider/model-name"
# Supported providers: gemini, openai, anthropic
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
LLM_ALLOWED_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-pro,openai/gpt-4o,openai/gpt-4.1,anthropic/claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
CHAT_CONTEXT_MESSAGE_LIMIT=20
CHAT_SYSTEM_PROMPT="You are Lux, a helpful and concise AI assistant."

REDIS_URL=redis://localhost:6379/0
CHAT_MEMORY_TTL_SECONDS=86400
